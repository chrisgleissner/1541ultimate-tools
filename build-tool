#!/usr/bin/env bash
# build-tool — build, deploy, and monitor 1541 Ultimate firmware via Docker
#
# Helpers are loaded from build-tool.d/ alongside this script. If that
# directory is missing, reinstall the tools with install.sh.
#
# Exit status: 0 success; 1 build failure; 2 deploy failure (including a
# failed FTP upload); 3 usage or setup error (bad option, Docker or a tool
# missing, a failed post-deploy check); 4 monitor failure.

# -E: the ERR trap (on_error) also fires inside functions.
set -Eeuo pipefail

SCRIPT_NAME=$(basename "$0")
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd -P)
HELPER_DIR="${SCRIPT_DIR}/build-tool.d"
TOOLING_DIR="${SCRIPT_DIR}/tooling"

# Per-checkout settings (device hosts, deploy paths), kept out of this script
# so that it stays the same everywhere. See .build-tool.env.example.
if [ -f "${SCRIPT_DIR}/.build-tool.env" ]; then
    set -a
    # shellcheck source=/dev/null
    source "${SCRIPT_DIR}/.build-tool.env"
    set +a
fi

# ---------------------------------------------------------------------------
# Defaults (read by helpers; must be set before sourcing them)
# ---------------------------------------------------------------------------
readonly DEFAULT_BASE_IMAGE="ghcr.io/gideonz/riscv:latest"
readonly DEFAULT_PREPARED_IMAGE="1541u-build:latest"
readonly PREPARED_IMAGE_REVISION="3"
readonly DEFAULT_DEPLOY_USER="anonymous"
readonly DEFAULT_DEPLOY_PASS=""
readonly DEFAULT_DEPLOY_PATH="/Temp/"
# The u64 default is the directory the 1541ultimate-tools README documents.
# Neither default has been checked against the FTP root of a real device:
# confirm with `curl ftp://<device>/ --list-only` before relying on it.
readonly DEFAULT_DEPLOY_PATH_U64="/Usb1/firmware/u64/custom/"
readonly DEFAULT_DEPLOY_PATH_U64II="/USB1/Firmware/custom/"
readonly DEFAULT_FTP_POST_JTAG_WAIT_SECS=3
readonly DEFAULT_JTAG_URL="${U64II_JTAG_URL:-ftdi://ftdi:232h/1}"

# ---------------------------------------------------------------------------
# Mutable global state
# ---------------------------------------------------------------------------
CURRENT_ACTION=""
DOCKER_IS_ROOTLESS=0
REPO_DIR=""

TARGETS=()
DEPLOY_TARGETS=()
JTAG_TARGETS=()
JTAG_MONITOR_TARGETS=()
UART_MONITOR_TARGETS=()
BUILT_TARGETS=()
BUILT_ARTIFACTS=()
FAILED_TARGETS=()
FAILED_DEPLOYS=()
FAILED_JTAGS=()
FAILED_JTAG_MONITORS=()
FAILED_UART_MONITORS=()

BUILD_FAILED=0
DEPLOY_FAILED=0
MONITOR_FAILED=0
VERIFY_FAILED=0

CLEAN_BUILD=0
SW_ONLY=0
PARALLEL_BUILD=0
SKIP_SUBMODULE_UPDATE=0
DRY_RUN=0
DEPLOY_ONLY=0
CUSTOM_IMAGE=0
CHECK_SUPPORT=0
U2_FLASH=0
U2_FLASH_ARGS=()
JTAG_APP_ONLY_TARGETS=()
APPLY_PRS=()
PR_BASE="HEAD"

JOBS=""
VERSION_STRING=""
DOCKER_IMAGE="$DEFAULT_PREPARED_IMAGE"
BASE_IMAGE="$DEFAULT_BASE_IMAGE"
# Host directory with FPGA/Nios toolchains, mounted read-only into the build
# container. Nothing is mounted unless it is named here or with --build-tools-dir.
BUILD_TOOLS_DIR="${BUILD_TOOL_TOOLS_DIR:-}"
DEPLOY_HOST=""
DEPLOY_USER="$DEFAULT_DEPLOY_USER"
DEPLOY_PASS="$DEFAULT_DEPLOY_PASS"
DEPLOY_PATH="$DEFAULT_DEPLOY_PATH"
DEPLOY_PATH_EXPLICIT=0
DEPLOY_FILE=""
JTAG_URL="$DEFAULT_JTAG_URL"
JTAG_MONITOR_SECS=5
UART_PORT=""
UART_BAUD=115200
UART_MONITOR_SECS=5
VERIFY_HOST=""
FTP_POST_JTAG_WAIT_SECS=$DEFAULT_FTP_POST_JTAG_WAIT_SECS
JTAG_FPGA=""

# Colour placeholders — filled in by setup_colors() inside logging.sh
COLOR_RED="" COLOR_GREEN="" COLOR_YELLOW=""
COLOR_BLUE="" COLOR_CYAN="" COLOR_BOLD="" COLOR_RESET=""

# ---------------------------------------------------------------------------
# Bootstrap: source helpers
# ---------------------------------------------------------------------------

REQUIRED_HELPERS=(logging.sh common.sh runtime.sh repo.sh targets.sh docker.sh
                  image.sh probe.sh build.sh deploy.sh
                  jtag.sh uart.sh verify.sh u2_flash.sh)

if [ ! -d "$HELPER_DIR" ]; then
    printf 'build-tool: helper directory not found at %s\n' "$HELPER_DIR" >&2
    printf 'Reinstall the tools with install.sh from the 1541ultimate-tools repository.\n' >&2
    exit 1
fi
for _helper in "${REQUIRED_HELPERS[@]}"; do
    if [ ! -f "${HELPER_DIR}/${_helper}" ]; then
        printf 'build-tool: missing helper %s in %s\n' "$_helper" "$HELPER_DIR" >&2
        printf 'Reinstall the tools with install.sh from the 1541ultimate-tools repository.\n' >&2
        exit 1
    fi
    # shellcheck source=/dev/null
    source "${HELPER_DIR}/${_helper}"
done
setup_colors
trap on_error ERR

# ---------------------------------------------------------------------------
# Usage / help
# ---------------------------------------------------------------------------

usage() {
    cat <<EOF
${COLOR_BOLD}USAGE${COLOR_RESET}
  ${SCRIPT_NAME} [OPTIONS] [TARGET...]

${COLOR_BOLD}DESCRIPTION${COLOR_RESET}
  Build, deploy, and monitor 1541 Ultimate firmware using Docker.
  The default action (no targets) builds u64, u64ii, and u2.

${COLOR_BOLD}TARGETS${COLOR_RESET}
  u2        Ultimate II (RISC-V)              -> update_<commit>.u2r
  u2plus    Ultimate II+                      -> update_<commit>.u2p
  u2pl      Ultimate II+L                     -> update_<commit>.u2l
  u64       Ultimate 64                       -> update_<commit>.u64
  u64ii     Ultimate 64 Elite II / C64 Ultimate -> update_<commit>.ue2  (alias: c64u)
  all       u64, u64ii and u2: the set built when no target is given
            (not u2plus or u2pl)

${COLOR_BOLD}BUILD OPTIONS${COLOR_RESET}
  -h, --help                 Show this help and exit
  -c, --clean                Clean before building
  -s, --sw-only              Software-only build (skip FPGA synthesis)
  -j, --jobs N               Parallel make jobs (default: auto)
  -v, --version STRING       Override version string (default: git short SHA)
  -i, --image IMAGE          Docker image to use (default: ${DEFAULT_PREPARED_IMAGE})
      --base-image IMAGE     Base image for preparing ${DEFAULT_PREPARED_IMAGE}
                             (default: ${DEFAULT_BASE_IMAGE})
      --build-tools-dir DIR  Mount host FPGA/Nios toolchains from DIR, read-only
                             (default: \$BUILD_TOOL_TOOLS_DIR; with neither, only
                             the image's toolchains are used, as in CI)
      --no-submodule-update  Skip git submodule init/update
      --parallel             Build all selected targets concurrently
      --dry-run              Print commands without executing them
      --repo-dir DIR         Repo root override (default: auto-detect via git)
      --apply-pr N           Build a throwaway worktree of the repo with upstream
                             1541ultimate PR N applied as uncommitted changes
                             (repeatable; tooling/apply_pr.sh). The worktree is
                             <repo>-pr<N>... beside the repo. After a conflict,
                             resolve it there and rerun: the PRs after it are
                             then applied.
      --pr-base REF          Commit that worktree starts at (default: HEAD)
      --check-support        Report which targets are buildable with current setup
      --list-targets         List all targets with their toolchain requirements

${COLOR_BOLD}DEPLOY OPTIONS${COLOR_RESET}
  -d, --deploy TARGET        Upload built artifact to a device via FTP
      --deploy-host HOST     Device hostname or IP (required)
      --deploy-user USER     FTP username (default: ${DEFAULT_DEPLOY_USER})
      --deploy-pass PASS     FTP password (default: empty)
      --deploy-path PATH     Remote directory override
                             (default: target-specific, else ${DEFAULT_DEPLOY_PATH})
      --deploy-only          Skip build; deploy pre-existing artifacts only. Needs
                             no Docker. Uploads update_<commit>.<ext> for the
                             commit at HEAD, under that name, and refuses when
                             only an artifact of another commit exists.
      --deploy-file FILE     With --deploy-only and one --deploy target: upload
                             FILE under its own name, whichever commit built it

${COLOR_BOLD}JTAG OPTIONS${COLOR_RESET}
      --jtag TARGET          Build the application only and run it from RAM over
                             JTAG (volatile; flash is never written).
                             u64: USB-Blaster + nios2-download.
                             u64ii/c64u: FT232H or USB-Blaster + the FPGA's
                             user JTAG chain
                             (tooling/u64ii_jtag.sh; see docs/c64u-jtag.md).
      --jtag-fpga BIT        u64ii: bitstream configured before the application:
                             'auto' (default, external/u64e2_*.bit by IDCODE),
                             a path, or 'warm' to keep the running FPGA image
                             and restart only the CPU (about 7 s faster)
      --jtag-monitor TARGET  Read the CPU's UART over JTAG (u64ii/c64u only; the
                             Ultimate 64 image has no JTAG UART, use --uart-monitor)
      --jtag-monitor-secs N  Capture JTAG output for N seconds (default: 5)
      --jtag-url URL         FT232H URL for u64ii, or 'blaster' for a USB-Blaster
                             (default: ${DEFAULT_JTAG_URL})

${COLOR_BOLD}UART OPTIONS${COLOR_RESET}
      --uart-monitor TARGET  Read UART serial output for a target (u64 only)
      --uart-port DEVICE     Serial device (e.g. /dev/ttyUSB0). Without it, the
                             only known USB-TTL adapter is used; an FTDI JTAG
                             adapter is never picked automatically.
      --uart-baud N          Baud rate (default: 115200)
      --uart-monitor-secs N  Capture duration in seconds (default: 5, 0 = until Ctrl-C)

${COLOR_BOLD}VERIFICATION OPTIONS${COLOR_RESET}
      --verify-host HOST     Device for the post-deploy REST check. Without it,
                             U64_VERIFY_HOST (u64) or U64II_VERIFY_HOST (u64ii)
                             is read from the environment or .build-tool.env;
                             with none set, the check is skipped.

${COLOR_BOLD}U2+L REST FLASH${COLOR_RESET}
      --u2-flash [ARGS...]   Install U2+L firmware by uploading update.u2l and
                             driving the on-device menu over REST (upload,
                             verify, browse, and monitor a flash to completion;
                             power-cycle requires an explicit --power-host and
                             --confirm-power-cycle). Consumes the rest of the
                             command line; run with --u2-flash --help for the
                             full option list (implemented in tools/api/u2_flash.py).

${COLOR_BOLD}NOTES${COLOR_RESET}
  u64ii embeds the Artix-7 bitstreams checked in under external/; building
  them needs Vivado and HDL sources that are not in this repository.
  U64_VERIFY_HOST and U64II_VERIFY_HOST are read from the environment, or from
  .build-tool.env beside this script. DEPLOY_HOST and DEPLOY_PATH are read by
  ./build only; build-tool takes --deploy-host and --deploy-path.
  Building fewer than u64, u64ii and u2 needs BUILD_TOOL_ALLOW_PARTIAL=1.
  Full u2 builds require Xilinx ISE.
  u2plus and u64 builds require Quartus/Nios tools even in --sw-only mode.
  Full u2pl builds require Lattice Diamond.
  The default image (${DEFAULT_PREPARED_IMAGE}) is prepared automatically from
  ${DEFAULT_BASE_IMAGE}, adding esp32, esp32c3, and esp32s3 IDF targets.

${COLOR_BOLD}EXAMPLES${COLOR_RESET}
  ${SCRIPT_NAME}
  ${SCRIPT_NAME} u64ii
  ${SCRIPT_NAME} u64ii u64
  ${SCRIPT_NAME} --parallel
  ${SCRIPT_NAME} -s u2 u2pl
  ${SCRIPT_NAME} u64ii -d u64ii --deploy-host <device-hostname>
  ${SCRIPT_NAME} --deploy-only -d u64ii --deploy-host <device-ip>
  ${SCRIPT_NAME} --jtag c64u
  ${SCRIPT_NAME} --repo-dir ../c64u-firmware c64u
  ${SCRIPT_NAME} --apply-pr 705 --pr-base upstream/master --jtag c64u
  ${SCRIPT_NAME} --jtag-monitor c64u --jtag-monitor-secs 10
  ${SCRIPT_NAME} --uart-monitor u64 --uart-port /dev/ttyUSB0
  ${SCRIPT_NAME} --deploy-only --deploy-file update_1234abcd.u64 -d u64 --deploy-host <device-ip>
  ${SCRIPT_NAME} --check-support --build-tools-dir ~/intelFPGA_lite/18.1
  ${SCRIPT_NAME} --list-targets
  ${SCRIPT_NAME} --u2-flash --dry-run
  ${SCRIPT_NAME} --u2-flash --upload-only
  ${SCRIPT_NAME} --u2-flash --confirm-flash --power-host <power-switch-host> --confirm-power-cycle
EOF
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

_require_arg() {
    [ "$#" -ge 2 ] || die_usage "Missing value for $1"
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage; exit 0
            ;;
        --list-targets)
            list_targets_table; exit 0
            ;;
        -c|--clean)
            CLEAN_BUILD=1
            ;;
        -s|--sw-only)
            SW_ONLY=1
            ;;
        --parallel)
            PARALLEL_BUILD=1
            ;;
        -j|--jobs)
            _require_arg "$@"; JOBS=$2; shift
            ;;
        -v|--version)
            _require_arg "$@"; VERSION_STRING=$2; shift
            ;;
        -i|--image)
            _require_arg "$@"; DOCKER_IMAGE=$2; CUSTOM_IMAGE=1; shift
            ;;
        --base-image)
            _require_arg "$@"; BASE_IMAGE=$2; shift
            ;;
        --build-tools-dir)
            _require_arg "$@"; BUILD_TOOLS_DIR=$2; shift
            ;;
        --no-submodule-update)
            SKIP_SUBMODULE_UPDATE=1
            ;;
        --dry-run)
            DRY_RUN=1
            ;;
        --check-support)
            CHECK_SUPPORT=1
            ;;
        --repo-dir)
            _require_arg "$@"; REPO_DIR=$2; shift
            ;;
        --apply-pr)
            _require_arg "$@"; APPLY_PRS+=("$2"); shift
            ;;
        --pr-base)
            _require_arg "$@"; PR_BASE=$2; shift
            ;;
        -d|--deploy)
            _require_arg "$@"
            validate_target_name "$2" || die_usage "Unknown deploy target: $2"
            DEPLOY_TARGETS+=("$2"); shift
            ;;
        --deploy-host)
            _require_arg "$@"; DEPLOY_HOST=$2; shift
            ;;
        --deploy-user)
            _require_arg "$@"; DEPLOY_USER=$2; shift
            ;;
        --deploy-pass)
            _require_arg "$@"; DEPLOY_PASS=$2; shift
            ;;
        --deploy-path)
            _require_arg "$@"; DEPLOY_PATH=$2; DEPLOY_PATH_EXPLICIT=1; shift
            ;;
        --deploy-file)
            # Resolved now: the script changes into the repository later.
            _require_arg "$@"; DEPLOY_FILE=$(realpath -m -- "$2"); shift
            ;;
        --deploy-only)
            DEPLOY_ONLY=1
            ;;
        --jtag)
            _require_arg "$@"
            validate_target_name "$2" || die_usage "Unknown JTAG target: $2"
            JTAG_TARGETS+=("$2"); shift
            ;;
        --jtag-monitor)
            _require_arg "$@"
            validate_target_name "$2" || die_usage "Unknown JTAG monitor target: $2"
            [ "$(normalize_target_name "$2")" = u64ii ] \
                || die_usage "--jtag-monitor supports only u64ii (c64u): the Ultimate 64 image has no JTAG UART. Use --uart-monitor u64."
            JTAG_MONITOR_TARGETS+=("$2"); shift
            ;;
        --jtag-monitor-secs)
            _require_arg "$@"; JTAG_MONITOR_SECS=$2; shift
            ;;
        --jtag-url)
            _require_arg "$@"; JTAG_URL=$2; shift
            ;;
        --jtag-fpga)
            _require_arg "$@"; JTAG_FPGA=$2; shift
            ;;
        --uart-monitor)
            _require_arg "$@"
            validate_target_name "$2" || die_usage "Unknown UART monitor target: $2"
            UART_MONITOR_TARGETS+=("$2"); shift
            ;;
        --uart-port)
            _require_arg "$@"; UART_PORT=$2; shift
            ;;
        --uart-baud)
            _require_arg "$@"; UART_BAUD=$2; shift
            ;;
        --uart-monitor-secs)
            _require_arg "$@"; UART_MONITOR_SECS=$2; shift
            ;;
        --verify-host)
            _require_arg "$@"; VERIFY_HOST=$2; shift
            ;;
        --u2-flash)
            U2_FLASH=1
            shift
            while [ "$#" -gt 0 ]; do
                U2_FLASH_ARGS+=("$1"); shift
            done
            break
            ;;
        --)
            shift
            while [ "$#" -gt 0 ]; do
                validate_target_name "$1" || die_usage "Unknown target: $1"
                TARGETS+=("$1"); shift
            done
            break
            ;;
        -*)
            die_usage "Unknown option: $1"
            ;;
        *)
            validate_target_name "$1" || die_usage "Unknown target: $1"
            TARGETS+=("$1")
            ;;
    esac
    shift
done

# ---------------------------------------------------------------------------
# Common setup
# ---------------------------------------------------------------------------

ensure_repo_root
ensure_git_ready

# ---------------------------------------------------------------------------
# --apply-pr: switch to a worktree with the pull requests applied
# ---------------------------------------------------------------------------

if [ "${#APPLY_PRS[@]}" -gt 0 ]; then
    _pr_tree="${REPO_DIR}-pr$(IFS=-; printf '%s' "${APPLY_PRS[*]}")"
    # An existing worktree is continued: PRs applied there are skipped, and
    # those after a resolved conflict are applied now.
    _pr_args=(--repo "$REPO_DIR" --base "$PR_BASE")
    if [ -d "$_pr_tree" ]; then
        log_info "Continuing in ${_pr_tree}; delete it to apply the PRs afresh."
        _pr_args+=(--keep)
    fi
    if [ "$DRY_RUN" -eq 1 ]; then
        log_info "$(quote_command "$TOOLING_DIR/apply_pr.sh" "${_pr_args[@]}" "${APPLY_PRS[@]}" "$_pr_tree")"
    else
        _pr_status=0
        "$TOOLING_DIR/apply_pr.sh" "${_pr_args[@]}" \
            "${APPLY_PRS[@]}" "$_pr_tree" || _pr_status=$?
        [ "$_pr_status" -eq 3 ] && die "Resolve the conflicts in ${_pr_tree}, then rerun this command."
        [ "$_pr_status" -eq 0 ] || die "Applying ${APPLY_PRS[*]} failed."
    fi
    REPO_DIR="$_pr_tree"
    [ "$DRY_RUN" -eq 1 ] && [ ! -d "$REPO_DIR" ] || cd "$REPO_DIR"
fi

# ---------------------------------------------------------------------------
# U2+L REST flash short-circuit (no build/Docker/toolchain setup needed)
# ---------------------------------------------------------------------------

if [ "$U2_FLASH" -eq 1 ]; then
    run_u2_flash "${U2_FLASH_ARGS[@]}"
    exit $?
fi

ensure_build_tools_dir
ensure_lattice_license_file

# ---------------------------------------------------------------------------
# Monitor-only short-circuit (no build/deploy requested)
# ---------------------------------------------------------------------------

MONITOR_ONLY=0
if [ "${#TARGETS[@]}" -eq 0 ] \
   && [ "${#DEPLOY_TARGETS[@]}" -eq 0 ] \
   && [ "${#JTAG_TARGETS[@]}" -eq 0 ] \
   && { [ "${#JTAG_MONITOR_TARGETS[@]}" -gt 0 ] \
        || [ "${#UART_MONITOR_TARGETS[@]}" -gt 0 ]; } \
   && [ "$DEPLOY_ONLY" -eq 0 ] \
   && [ "$CHECK_SUPPORT" -eq 0 ]; then
    MONITOR_ONLY=1
fi

if [ "$MONITOR_ONLY" -eq 1 ]; then
    _mon_target="" _mon_resolved=()

    if [ "${#JTAG_MONITOR_TARGETS[@]}" -gt 0 ]; then
        while IFS= read -r _mon_target; do _mon_resolved+=("$_mon_target"); done \
            < <(resolve_target_list "${JTAG_MONITOR_TARGETS[@]}")
        for _mon_target in "${_mon_resolved[@]}"; do run_jtag_monitor "$_mon_target" || true; done
    fi

    _mon_resolved=()
    if [ "${#UART_MONITOR_TARGETS[@]}" -gt 0 ]; then
        while IFS= read -r _mon_target; do _mon_resolved+=("$_mon_target"); done \
            < <(resolve_target_list "${UART_MONITOR_TARGETS[@]}")
        for _mon_target in "${_mon_resolved[@]}"; do run_uart_monitor "$_mon_target" || true; done
    fi

    if [ "$MONITOR_FAILED" -ne 0 ]; then
        [ "${#FAILED_JTAG_MONITORS[@]}"  -gt 0 ] && log_warn "JTAG monitor failures: ${FAILED_JTAG_MONITORS[*]}"
        [ "${#FAILED_UART_MONITORS[@]}" -gt 0 ] && log_warn "UART monitor failures: ${FAILED_UART_MONITORS[*]}"
        exit 4
    fi
    log_success "Completed successfully."
    exit 0
fi

# ---------------------------------------------------------------------------
# Docker + version setup
# ---------------------------------------------------------------------------

# A deploy-only run uploads or loads files that already exist and needs no
# container. Everything else, including --check-support, runs in the image.
NEED_DOCKER=1
[ "$DEPLOY_ONLY" -eq 1 ] && [ "$CHECK_SUPPORT" -eq 0 ] && NEED_DOCKER=0

if [ "$NEED_DOCKER" -eq 1 ]; then
    ensure_docker_ready
fi
detect_jobs
resolve_version
normalize_deploy_path

# A JTAG-only U64 invocation needs the application ELF, not an installation
# package.  Treat the JTAG targets as the build selection when no positional
# targets were supplied; otherwise the historical default expands to every
# firmware target before downloading just one ELF.
if [ "${#TARGETS[@]}" -eq 0 ] \
   && [ "${#JTAG_TARGETS[@]}" -gt 0 ] \
   && [ "${#DEPLOY_TARGETS[@]}" -eq 0 ] \
   && [ "$DEPLOY_ONLY" -eq 0 ]; then
    TARGETS=("${JTAG_TARGETS[@]}")
fi
expand_targets "${TARGETS[@]}"

# A JTAG run loads the application image directly (ultimate.elf on the u64,
# ultimate.bin on the u64ii). Do not build the ESP32 firmware or package the
# updater unless an FTP deploy also needs the update file.
if [ "$DEPLOY_ONLY" -eq 0 ] && [ "${#JTAG_TARGETS[@]}" -gt 0 ]; then
    _jtag_list=$(resolve_target_list "${JTAG_TARGETS[@]}")
    _deploy_list=""
    [ "${#DEPLOY_TARGETS[@]}" -gt 0 ] && _deploy_list=$(resolve_target_list "${DEPLOY_TARGETS[@]}")
    for _ja_t in u64 u64ii; do
        if contains_value "$_ja_t" "${TARGETS[@]}" \
           && grep -qx "$_ja_t" <<<"$_jtag_list" \
           && ! grep -qx "$_ja_t" <<<"$_deploy_list"; then
            JTAG_APP_ONLY_TARGETS+=("$_ja_t")
        fi
    done
fi
enforce_required_targets

if [ "$DEPLOY_ONLY" -eq 1 ] \
   && [ "${#DEPLOY_TARGETS[@]}" -eq 0 ] \
   && [ "${#JTAG_TARGETS[@]}" -eq 0 ] \
   && [ "${#JTAG_MONITOR_TARGETS[@]}" -eq 0 ] \
   && [ "${#UART_MONITOR_TARGETS[@]}" -eq 0 ]; then
    die_usage "--deploy-only requires at least one --deploy, --jtag, --jtag-monitor, or --uart-monitor target."
fi

validate_deploy_file
verify_build_prereqs
if [ "$NEED_DOCKER" -eq 1 ]; then
    prepare_image
fi

# ---------------------------------------------------------------------------
# --check-support
# ---------------------------------------------------------------------------

if [ "$CHECK_SUPPORT" -eq 1 ]; then
    if check_support; then
        log_success "All selected targets are buildable with the current configuration."
        exit 0
    fi
    log_warn "One or more selected targets are not buildable with the current configuration."
    exit 1
fi

# ---------------------------------------------------------------------------
# Build phase
# ---------------------------------------------------------------------------

if [ "$DEPLOY_ONLY" -eq 0 ]; then
    update_submodules
    run_clean
    preseed_make_dirs

    # A dry run builds nothing, so there is nothing to run concurrently.
    if [ "$PARALLEL_BUILD" -eq 1 ] && [ "${#TARGETS[@]}" -gt 1 ] && [ "$DRY_RUN" -eq 0 ]; then
        build_targets_parallel || true
    else
        _bt=""
        for _bt in "${TARGETS[@]}"; do
            build_target "$_bt" || true
        done
    fi

    # A target whose artifact fails the check counts as not built, so no
    # deploy step below picks it up.
    _checked=()
    for _bt in "${BUILT_TARGETS[@]+"${BUILT_TARGETS[@]}"}"; do
        if verify_build_artifact "$_bt"; then
            _checked+=("$_bt")
        else
            BUILD_FAILED=1
            FAILED_TARGETS+=("$_bt")
            log_error "Artifact check failed for ${_bt}; it will not be deployed."
        fi
    done
    BUILT_TARGETS=("${_checked[@]+"${_checked[@]}"}")
fi

print_summary

# ---------------------------------------------------------------------------
# Deploy phase
# ---------------------------------------------------------------------------

if [ "${#JTAG_TARGETS[@]}" -gt 0 ]; then
    _jt_t="" _jt_r=()
    while IFS= read -r _jt_t; do _jt_r+=("$_jt_t"); done \
        < <(resolve_target_list "${JTAG_TARGETS[@]}")
    for _jt_t in "${_jt_r[@]}"; do
        # The helpers load whatever image is on disk, so a target that failed
        # or was not built in this run would deploy a stale one and report
        # success. Same rule as the FTP deploy; --deploy-only opts out.
        if [ "$DEPLOY_ONLY" -eq 0 ] \
           && ! contains_value "$_jt_t" "${BUILT_TARGETS[@]+"${BUILT_TARGETS[@]}"}"; then
            DEPLOY_FAILED=1; FAILED_JTAGS+=("$_jt_t")
            log_error "Not deploying ${_jt_t} over JTAG: it was not built successfully in this run."
            continue
        fi
        run_jtag_recovery "$_jt_t" || true
    done
    for _jt_t in "${_jt_r[@]}"; do
        contains_value "$_jt_t" "${FAILED_JTAGS[@]+"${FAILED_JTAGS[@]}"}" \
            || verify_deployment "$_jt_t" || true
    done
fi

if [ "${#DEPLOY_TARGETS[@]}" -gt 0 ]; then
    [ "$DRY_RUN" -eq 1 ] || require_command curl
    if [ "${#JTAG_TARGETS[@]}" -gt 0 ]; then
        CURRENT_ACTION="Waiting ${FTP_POST_JTAG_WAIT_SECS}s after JTAG deployment"
        run_command sleep "$FTP_POST_JTAG_WAIT_SECS"
        CURRENT_ACTION=""
    fi

    _dp_t="" _dp_r=()
    while IFS= read -r _dp_t; do _dp_r+=("$_dp_t"); done \
        < <(resolve_target_list "${DEPLOY_TARGETS[@]}")
    for _dp_t in "${_dp_r[@]}"; do deploy_target "$_dp_t" || true; done
fi

if [ "${#JTAG_MONITOR_TARGETS[@]}" -gt 0 ]; then
    _jm_t="" _jm_r=()
    while IFS= read -r _jm_t; do _jm_r+=("$_jm_t"); done \
        < <(resolve_target_list "${JTAG_MONITOR_TARGETS[@]}")
    for _jm_t in "${_jm_r[@]}"; do run_jtag_monitor "$_jm_t" || true; done
fi

# ---------------------------------------------------------------------------
# Final exit status
# ---------------------------------------------------------------------------

[ "$BUILD_FAILED"   -ne 0 ] && log_warn "Build failures:       ${FAILED_TARGETS[*]}"
[ "$DEPLOY_FAILED"  -ne 0 ] && {
    [ "${#FAILED_DEPLOYS[@]}" -gt 0 ] && log_warn "Deploy failures:      ${FAILED_DEPLOYS[*]}"
    [ "${#FAILED_JTAGS[@]}"   -gt 0 ] && log_warn "JTAG failures:        ${FAILED_JTAGS[*]}"
}
[ "$MONITOR_FAILED" -ne 0 ] && log_warn "JTAG monitor failures: ${FAILED_JTAG_MONITORS[*]}"

[ "$DEPLOY_FAILED"  -ne 0 ] && exit 2
[ "$MONITOR_FAILED" -ne 0 ] && exit 4
[ "$BUILD_FAILED"   -ne 0 ] && exit 1
[ "$VERIFY_FAILED"  -ne 0 ] && { log_warn "Post-deploy verification failed."; exit 3; }

if [ "$DRY_RUN" -eq 1 ]; then
    log_success "Dry run finished. Nothing was built, deployed or written."
    exit 0
fi
log_success "Completed successfully."
